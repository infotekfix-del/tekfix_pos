rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // -------------------------------------------------------------
    // Core Authentication & Role Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(shopId) {
      return isSignedIn() && (
        // 1. Direct shop owner check via ownerUid field on active shop
        (exists(/databases/$(db)/documents/shops/$(shopId)) &&
         'ownerUid' in get(/databases/$(db)/documents/shops/$(shopId)).data &&
         get(/databases/$(db)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid &&
         (!('active' in get(/databases/$(db)/documents/shops/$(shopId)).data) ||
          get(/databases/$(db)/documents/shops/$(shopId)).data.active != false)) ||
        // 2. Active, approved owner/admin in shop users collection
        (exists(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data &&
         (!('active' in get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data) ||
          get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.active != false) &&
         (!('approved' in get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data) ||
          get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.approved != false) &&
         (get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.role == 'owner' ||
          get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.role == 'admin'))
      );
    }

    function isShopMember(shopId) {
      return isSignedIn() && (
        isOwner(shopId) ||
        // 1. Active member in shop users collection
        (exists(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)) &&
         (!('active' in get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data) ||
          get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.active != false) &&
         (!('approved' in get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data) ||
          get(/databases/$(db)/documents/shops/$(shopId)/users/$(request.auth.uid)).data.approved != false)) ||
        // 2. Exists in staff collection
        exists(/databases/$(db)/documents/shops/$(shopId)/staff/$(request.auth.uid)) ||
        // 3. Exists in members collection
        exists(/databases/$(db)/documents/shops/$(shopId)/members/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------
    // Shop Isolation & Subcollection Rules (/shops/{shop})
    // -------------------------------------------------------------
    match /shops/{shop} {
      allow read: if isShopMember(shop);
      allow create: if isSignedIn() && (
        request.resource.data.ownerUid == request.auth.uid ||
        isOwner(shop)
      );
      // Only the owner may change the shop document, and nobody can move
      // ownerUid from the client (staff could otherwise make themselves owner).
      allow update: if isOwner(shop) &&
        request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null);
      allow delete: if isOwner(shop);

      // 1. Service Jobs & Invoices (Service Checkout / Sale to Customer)
      match /service_jobs/{jobId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /services/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /sales_invoices/{invoiceId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /sales/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /sales_orders/{orderId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      // 2. Inventory & Stock Updates (stockCount decrement & logs)
      match /inventory/{itemId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /items/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /inventory_logs/{logId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /inventory_private/{itemId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /stockMovements/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /stock_moves/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      // 3. Accounting & Cash Registers
      match /accounting_cash_bank/{txId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /daily_registers/{dateId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /{allChildren=**} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /daily_sales/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /daily_sales_ledger/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /counters/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /payment_records/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /payments/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      // 4. Staff, Attendance & Salary
      match /staff/{staffId} {
        allow read: if isShopMember(shop);
        allow create, update: if isOwner(shop);
        allow delete: if isOwner(shop);
      }

      match /staff_attendance/{recordId} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /attendance/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /salary_payments/{paymentId} {
        allow read: if isShopMember(shop);
        allow create, update: if isOwner(shop);
        allow delete: if isOwner(shop);
      }

      // 5. Users and authentication
      match /users/{uid} {
        allow read: if isShopMember(shop);
        // Owner/admin manage all users. A signed-in user may create only their
        // own OWNER record while registering a brand-new shop in the same
        // batch (shop did not exist before, and its ownerUid is them).
        allow create: if isOwner(shop) || (
          isSignedIn() && request.auth.uid == uid &&
          request.resource.data.get('role', '') == 'owner' &&
          !exists(/databases/$(db)/documents/shops/$(shop)) &&
          getAfter(/databases/$(db)/documents/shops/$(shop)).data.ownerUid == request.auth.uid);
        // Users may edit their own record but never their role or approval.
        allow update: if isOwner(shop) || (
          isSignedIn() && request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active', 'approved']));
        allow delete: if isOwner(shop);
      }

      // 6. Shop metadata and settings
      match /meta/{doc} {
        allow read: if isShopMember(shop);
        allow write: if isOwner(shop);
      }

      match /settings/{doc} {
        allow read: if isShopMember(shop);
        allow write: if isOwner(shop);
      }

      // 7. Parties, Purchases & Expenses
      match /parties/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /purchases/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /expenses/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /rent_records/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /owner_withdrawals/{id} {
        allow read: if isOwner(shop);
        allow write: if isOwner(shop);
      }

      match /returns/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /vendor_payments/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      // 8. Purchase automation, products, stock units & vendor accounting
      match /products/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /purchase_bills/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);

        match /items/{itemId} {
          allow read: if isShopMember(shop);
          allow create, update: if isShopMember(shop);
          allow delete: if isOwner(shop);
        }
      }

      match /stock_units/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /vendor_ledger/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /audit_logs/{id} {
        allow read: if isShopMember(shop);
        allow create: if isShopMember(shop);
        allow update, delete: if isOwner(shop);
      }

      match /attendanceAudit/{id} {
        allow read: if isShopMember(shop);
        allow create: if isShopMember(shop);
        allow update, delete: if isOwner(shop);
      }

      match /priceApprovals/{id} {
        allow read: if isShopMember(shop);
        allow write: if isShopMember(shop);
      }

      match /activity_logs/{id} {
        allow read: if isShopMember(shop);
        allow create: if isShopMember(shop);
        allow update, delete: if isOwner(shop);
      }

      match /bank_txns/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /bank/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /orders/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      match /notifications/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isShopMember(shop);
        allow delete: if isOwner(shop);
      }

      // -------------------------------------------------------------
      // 17b. CUSTOMER CRM (customers live in /parties above)
      // Staff/biller: read templates + settings, write message log entries.
      // Owner/admin: everything. Nothing is readable without sign-in AND
      // shop membership, so customer phone numbers never leak.
      // -------------------------------------------------------------
      match /message_templates/{id} {
        allow read: if isShopMember(shop);
        allow create, update, delete: if isOwner(shop);
      }

      match /crm_settings/{id} {
        allow read: if isShopMember(shop);
        allow create, update, delete: if isOwner(shop);
      }

      match /campaigns/{id} {
        allow read, create, update, delete: if isOwner(shop);
      }

      match /message_log/{id} {
        allow read: if isOwner(shop);
        allow create: if isShopMember(shop) &&
          request.resource.data.customerId is string &&
          request.resource.data.status in ['sent', 'skipped', 'failed'];
        allow update, delete: if isOwner(shop);
      }

      // -------------------------------------------------------------
      // 18. RECHARGE & UTILITY ACCOUNTING MODULE
      // -------------------------------------------------------------
      // Wallets: Owner can create/top-up balances (non-negative); Direct staff updates are strictly DENIED.
      // Recharge debits MUST be processed through authorized trusted server-side operation.
      match /recharge_wallets/{walletId} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop) &&
          (!('totalBalancePaise' in request.resource.data) || request.resource.data.totalBalancePaise >= 0) &&
          (!('ownPrepaidBalancePaise' in request.resource.data) || request.resource.data.ownPrepaidBalancePaise >= 0) &&
          (!('distributorCreditBalancePaise' in request.resource.data) || request.resource.data.distributorCreditBalancePaise >= 0);
        allow update: if isOwner(shop) &&
          (!('totalBalancePaise' in request.resource.data) || request.resource.data.totalBalancePaise >= 0) &&
          (!('ownPrepaidBalancePaise' in request.resource.data) || request.resource.data.ownPrepaidBalancePaise >= 0) &&
          (!('distributorCreditBalancePaise' in request.resource.data) || request.resource.data.distributorCreditBalancePaise >= 0);
        allow delete: if false; // Wallets are permanent shop assets
      }

      // Wallet Ledger: Immutable append-only audit trail
      match /recharge_wallet_logs/{logId} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop); // Owner top-up or trusted backend (Admin SDK) only
        allow update, delete: if false; // Strict financial ledger immutability
      }

      // Recharge Transactions: Phase 13.3.0 Owner-Only Recharge Policy
      // Recharge operations are restricted exclusively to verified shop owners. Staff accounts are rejected.
      match /recharge_transactions/{txnId} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop);
        allow update: if isOwner(shop);
        allow delete: if false;
      }

      // Distributor Profiles & Outstanding
      match /recharge_distributors/{distId} {
        allow read: if isShopMember(shop);
        allow create, update: if isOwner(shop); // Owner-only: staff must not edit payable/outstanding
        allow delete: if isOwner(shop);
      }

      // Distributor Ledger: Immutable append-only payable audit trail
      match /recharge_distributor_ledger/{id} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop);
        allow update, delete: if false; // Strict financial ledger immutability
      }

      // Reversals & Refunds: Immutable financial reversal vouchers
      match /recharge_reversals/{id} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop);
        allow update, delete: if false; // Strict financial ledger immutability
      }

      match /recharge_refunds/{id} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop);
        allow update, delete: if false; // Strict financial ledger immutability
      }

      // Commissions & Float Deposits
      match /recharge_commissions/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isOwner(shop);
        allow delete: if isOwner(shop);
      }

      match /recharge_float_deposits/{id} {
        allow read: if isShopMember(shop);
        allow create: if isOwner(shop);
        allow update, delete: if false; // Immutable bank contra records
      }

      match /recharge_daily_collections/{id} {
        allow read: if isShopMember(shop);
        allow create, update: if isOwner(shop); // Owner-only recharge accounting
        allow delete: if isOwner(shop);
      }

      // Daily Operator Opening & Closing Balance Reconciliation (Phase 12.4 Hardened)
      match /recharge_daily_reconciliation/{businessDate} {
        allow read: if isShopMember(shop);

        allow create: if isShopMember(shop) && (
          request.resource.data.shopId == shop &&
          request.resource.data.businessDate == businessDate &&
          (!('isImmutable' in request.resource.data) || request.resource.data.isImmutable == false) &&
          (!('isReviewedByOwner' in request.resource.data) || request.resource.data.isReviewedByOwner == false) &&
          (!('closingStatus' in request.resource.data) || request.resource.data.closingStatus == 'pending') &&
          (!('reconciliationStatus' in request.resource.data) || request.resource.data.reconciliationStatus in ['pending', 'incomplete']) &&
          (!('reviewedBy' in request.resource.data) || request.resource.data.reviewedBy == null) &&
          (!('reviewedAt' in request.resource.data) || request.resource.data.reviewedAt == null) &&
          (!('closedBy' in request.resource.data) || request.resource.data.closedBy == null) &&
          (!('closedAt' in request.resource.data) || request.resource.data.closedAt == null) &&
          (!('corrections' in request.resource.data) || request.resource.data.corrections.size() == 0) &&
          // Verify operator maps do not contain closing or review data
          (!('operators' in request.resource.data) || (
            (!('jio' in request.resource.data.operators) || (
              (!('actualClosingBalancePaise' in request.resource.data.operators.jio) || request.resource.data.operators.jio.actualClosingBalancePaise == 0) &&
              (!('expectedClosingBalancePaise' in request.resource.data.operators.jio) || request.resource.data.operators.jio.expectedClosingBalancePaise == 0) &&
              (!('differencePaise' in request.resource.data.operators.jio) || request.resource.data.operators.jio.differencePaise == 0) &&
              (!('isClosingCompleted' in request.resource.data.operators.jio) || request.resource.data.operators.jio.isClosingCompleted == false) &&
              (!('isReviewedByOwner' in request.resource.data.operators.jio) || request.resource.data.operators.jio.isReviewedByOwner == false) &&
              (!('reviewedBy' in request.resource.data.operators.jio) || request.resource.data.operators.jio.reviewedBy == null) &&
              (!('reviewedAt' in request.resource.data.operators.jio) || request.resource.data.operators.jio.reviewedAt == null) &&
              (!('closingEnteredBy' in request.resource.data.operators.jio) || request.resource.data.operators.jio.closingEnteredBy == null || request.resource.data.operators.jio.closingEnteredBy == '') &&
              (!('closingEnteredAt' in request.resource.data.operators.jio) || request.resource.data.operators.jio.closingEnteredAt == null)
            )) &&
            (!('airtel' in request.resource.data.operators) || (
              (!('actualClosingBalancePaise' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.actualClosingBalancePaise == 0) &&
              (!('expectedClosingBalancePaise' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.expectedClosingBalancePaise == 0) &&
              (!('differencePaise' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.differencePaise == 0) &&
              (!('isClosingCompleted' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.isClosingCompleted == false) &&
              (!('isReviewedByOwner' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.isReviewedByOwner == false) &&
              (!('reviewedBy' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.reviewedBy == null) &&
              (!('reviewedAt' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.reviewedAt == null) &&
              (!('closingEnteredBy' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.closingEnteredBy == null || request.resource.data.operators.airtel.closingEnteredBy == '') &&
              (!('closingEnteredAt' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.closingEnteredAt == null)
            )) &&
            (!('vi' in request.resource.data.operators) || (
              (!('actualClosingBalancePaise' in request.resource.data.operators.vi) || request.resource.data.operators.vi.actualClosingBalancePaise == 0) &&
              (!('expectedClosingBalancePaise' in request.resource.data.operators.vi) || request.resource.data.operators.vi.expectedClosingBalancePaise == 0) &&
              (!('differencePaise' in request.resource.data.operators.vi) || request.resource.data.operators.vi.differencePaise == 0) &&
              (!('isClosingCompleted' in request.resource.data.operators.vi) || request.resource.data.operators.vi.isClosingCompleted == false) &&
              (!('isReviewedByOwner' in request.resource.data.operators.vi) || request.resource.data.operators.vi.isReviewedByOwner == false) &&
              (!('reviewedBy' in request.resource.data.operators.vi) || request.resource.data.operators.vi.reviewedBy == null) &&
              (!('reviewedAt' in request.resource.data.operators.vi) || request.resource.data.operators.vi.reviewedAt == null) &&
              (!('closingEnteredBy' in request.resource.data.operators.vi) || request.resource.data.operators.vi.closingEnteredBy == null || request.resource.data.operators.vi.closingEnteredBy == '') &&
              (!('closingEnteredAt' in request.resource.data.operators.vi) || request.resource.data.operators.vi.closingEnteredAt == null)
            )) &&
            (!('bsnl' in request.resource.data.operators) || (
              (!('actualClosingBalancePaise' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.actualClosingBalancePaise == 0) &&
              (!('expectedClosingBalancePaise' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.expectedClosingBalancePaise == 0) &&
              (!('differencePaise' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.differencePaise == 0) &&
              (!('isClosingCompleted' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.isClosingCompleted == false) &&
              (!('isReviewedByOwner' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.isReviewedByOwner == false) &&
              (!('reviewedBy' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.reviewedBy == null) &&
              (!('reviewedAt' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.reviewedAt == null) &&
              (!('closingEnteredBy' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.closingEnteredBy == null || request.resource.data.operators.bsnl.closingEnteredBy == '') &&
              (!('closingEnteredAt' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.closingEnteredAt == null)
            ))
          ))
        );

        allow update: if isShopMember(shop) && (
          // Record must not be locked / immutable
          (!('isImmutable' in resource.data) || resource.data.isImmutable != true) &&

          // Audit notes array must be append-only / never truncated or rewritten
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['auditNotes']) || (
            'auditNotes' in request.resource.data && (
              !('auditNotes' in resource.data) || (
                request.resource.data.auditNotes.size() >= resource.data.auditNotes.size() &&
                request.resource.data.auditNotes.hasAll(resource.data.auditNotes)
              )
            )
          )) &&

          // 1. OPENING IMMUTABILITY (Applies to both Owner and Staff)
          (!('openingStatus' in resource.data) || resource.data.openingStatus != 'completed' || (
            request.resource.data.openingStatus == 'completed' &&
            request.resource.data.openedBy == resource.data.openedBy &&
            request.resource.data.openedAt == resource.data.openedAt &&
            (!('operators' in resource.data) || (
              (!('jio' in resource.data.operators) || !('openingBalancePaise' in resource.data.operators.jio) || request.resource.data.operators.jio.openingBalancePaise == resource.data.operators.jio.openingBalancePaise) &&
              (!('airtel' in resource.data.operators) || !('openingBalancePaise' in resource.data.operators.airtel) || request.resource.data.operators.airtel.openingBalancePaise == resource.data.operators.airtel.openingBalancePaise) &&
              (!('vi' in resource.data.operators) || !('openingBalancePaise' in resource.data.operators.vi) || request.resource.data.operators.vi.openingBalancePaise == resource.data.operators.vi.openingBalancePaise) &&
              (!('bsnl' in resource.data.operators) || !('openingBalancePaise' in resource.data.operators.bsnl) || request.resource.data.operators.bsnl.openingBalancePaise == resource.data.operators.bsnl.openingBalancePaise)
            ))
          )) &&

          // 2. CLOSING IMMUTABILITY (Applies to both Owner and Staff)
          (!('closingStatus' in resource.data) || resource.data.closingStatus != 'completed' || (
            request.resource.data.closingStatus == 'completed' &&
            request.resource.data.closedBy == resource.data.closedBy &&
            request.resource.data.closedAt == resource.data.closedAt &&
            (!('operators' in resource.data) || (
              (!('jio' in resource.data.operators) || !('actualClosingBalancePaise' in resource.data.operators.jio) || request.resource.data.operators.jio.actualClosingBalancePaise == resource.data.operators.jio.actualClosingBalancePaise) &&
              (!('airtel' in resource.data.operators) || !('actualClosingBalancePaise' in resource.data.operators.airtel) || request.resource.data.operators.airtel.actualClosingBalancePaise == resource.data.operators.airtel.actualClosingBalancePaise) &&
              (!('vi' in resource.data.operators) || !('actualClosingBalancePaise' in resource.data.operators.vi) || request.resource.data.operators.vi.actualClosingBalancePaise == resource.data.operators.vi.actualClosingBalancePaise) &&
              (!('bsnl' in resource.data.operators) || !('actualClosingBalancePaise' in resource.data.operators.bsnl) || request.resource.data.operators.bsnl.actualClosingBalancePaise == resource.data.operators.bsnl.actualClosingBalancePaise) &&
              (!('jio' in resource.data.operators) || !('expectedClosingBalancePaise' in resource.data.operators.jio) || request.resource.data.operators.jio.expectedClosingBalancePaise == resource.data.operators.jio.expectedClosingBalancePaise) &&
              (!('airtel' in resource.data.operators) || !('expectedClosingBalancePaise' in resource.data.operators.airtel) || request.resource.data.operators.airtel.expectedClosingBalancePaise == resource.data.operators.airtel.expectedClosingBalancePaise) &&
              (!('vi' in resource.data.operators) || !('expectedClosingBalancePaise' in resource.data.operators.vi) || request.resource.data.operators.vi.expectedClosingBalancePaise == resource.data.operators.vi.expectedClosingBalancePaise) &&
              (!('bsnl' in resource.data.operators) || !('expectedClosingBalancePaise' in resource.data.operators.bsnl) || request.resource.data.operators.bsnl.expectedClosingBalancePaise == resource.data.operators.bsnl.expectedClosingBalancePaise) &&
              (!('jio' in resource.data.operators) || !('differencePaise' in resource.data.operators.jio) || request.resource.data.operators.jio.differencePaise == resource.data.operators.jio.differencePaise) &&
              (!('airtel' in resource.data.operators) || !('differencePaise' in resource.data.operators.airtel) || request.resource.data.operators.airtel.differencePaise == resource.data.operators.airtel.differencePaise) &&
              (!('vi' in resource.data.operators) || !('differencePaise' in resource.data.operators.vi) || request.resource.data.operators.vi.differencePaise == resource.data.operators.vi.differencePaise) &&
              (!('bsnl' in resource.data.operators) || !('differencePaise' in resource.data.operators.bsnl) || request.resource.data.operators.bsnl.differencePaise == resource.data.operators.bsnl.differencePaise)
            ))
          )) &&

          // 3. ROLE-SPECIFIC PERMISSIONS
          (
            // Owner Review & Lock actions
            (isOwner(shop) && (
              // Owner review verification: reviewedBy must not be forged
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewedBy'])) ||
              (request.resource.data.reviewedBy.matches('.*' + request.auth.uid + '.*') ||
               (request.auth.token.email != null && request.resource.data.reviewedBy.matches('.*' + request.auth.token.email + '.*')))
            )) ||

            // Staff actions (Opening or Closing entry)
            (!isOwner(shop) && (
              // Staff cannot review, self-approve, or lock record
              request.resource.data.reconciliationStatus != 'reviewed' &&
              (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isImmutable', 'reviewedBy', 'reviewedAt', 'createdBy'])) &&
              // Once closed, staff cannot change reconciliation status
              (!('closingStatus' in resource.data) || resource.data.closingStatus != 'completed' || request.resource.data.reconciliationStatus == resource.data.reconciliationStatus) &&
              // Staff cannot self-approve on operator level
              (!('operators' in request.resource.data) || (
                (!('jio' in request.resource.data.operators) || !('isReviewedByOwner' in request.resource.data.operators.jio) || request.resource.data.operators.jio.isReviewedByOwner == false || ('operators' in resource.data && 'jio' in resource.data.operators && resource.data.operators.jio.isReviewedByOwner == true)) &&
                (!('airtel' in request.resource.data.operators) || !('isReviewedByOwner' in request.resource.data.operators.airtel) || request.resource.data.operators.airtel.isReviewedByOwner == false || ('operators' in resource.data && 'airtel' in resource.data.operators && resource.data.operators.airtel.isReviewedByOwner == true)) &&
                (!('vi' in request.resource.data.operators) || !('isReviewedByOwner' in request.resource.data.operators.vi) || request.resource.data.operators.vi.isReviewedByOwner == false || ('operators' in resource.data && 'vi' in resource.data.operators && resource.data.operators.vi.isReviewedByOwner == true)) &&
                (!('bsnl' in request.resource.data.operators) || !('isReviewedByOwner' in request.resource.data.operators.bsnl) || request.resource.data.operators.bsnl.isReviewedByOwner == false || ('operators' in resource.data && 'bsnl' in resource.data.operators && resource.data.operators.bsnl.isReviewedByOwner == true))
              ))
            ))
          )
        );

        allow delete: if false; // Permanent reconciliation records

        // Subcollection: Immutable append-only correction vouchers
        match /corrections/{correctionId} {
          allow read: if isShopMember(shop);
          allow create: if isShopMember(shop) && (
            // Owner can create approved correction directly
            (isOwner(shop) &&
             request.resource.data.correctionId == correctionId &&
             request.resource.data.approvedBy == request.auth.uid &&
             request.resource.data.status in ['approved', 'rejected']) ||
            // Staff can submit pending correction request
            (!isOwner(shop) &&
             request.resource.data.correctionId == correctionId &&
             request.resource.data.requestedBy == request.auth.uid &&
             request.resource.data.status == 'pending' &&
             !('approvedBy' in request.resource.data))
          );
          allow update: if isOwner(shop) &&
            resource.data.status == 'pending' &&
            request.resource.data.status in ['approved', 'rejected'] &&
            request.resource.data.approvedBy == request.auth.uid &&
            request.resource.data.requestedBy != request.auth.uid; // Staff requested, owner approved
          allow delete: if false; // Immutable audit documents
        }
      }

      // -------------------------------------------------------------
      // 19. OWNER TRUSTED DEVICES MODULE (PHASE 13.3.3)
      // -------------------------------------------------------------
      match /trusted_devices/{deviceId} {
        // Read: Only verified shop owner can inspect registered devices
        allow read: if isOwner(shop);

        // Direct client creation & modification is strictly DENIED.
        // Device enrollment must go through trusted Cloud Function 'registerTrustedDevice'.
        allow create, update, delete: if false;
      }

      // Ephemeral cryptographic nonces for challenge-response auth
      match /device_challenges/{nonceId} {
        allow read, write: if false; // Cloud Functions Admin SDK only
      }

      // Universal catch-all for any other shop subcollections
      match /{document=**} {
        allow read: if isShopMember(shop) &&
          !(request.path[5] in ['campaigns', 'message_log', 'trusted_devices', 'device_challenges']);
        allow create, update: if isShopMember(shop) &&
          !(request.path[5] in [
            'recharge_wallets',
            'recharge_transactions',
            'recharge_wallet_logs',
            'recharge_distributor_ledger',
            'recharge_distributors',
            'recharge_reversals',
            'recharge_refunds',
            'recharge_commissions',
            'recharge_float_deposits',
            'recharge_daily_collections',
            'recharge_daily_reconciliation',
            // Owner-only collections that have their own rules above. Firestore
            // allows a request if ANY matching rule allows it, so without this
            // list the catch-all would let staff rewrite roles and settings.
            'users',
            'salary_payments',
            'settings',
            'meta',
            'owner_withdrawals',
            'trusted_devices',
            'device_challenges'
          ]);
        allow delete: if isOwner(shop) &&
          !(request.path[5] in [
            'recharge_wallets',
            'recharge_transactions',
            'recharge_wallet_logs',
            'recharge_distributor_ledger',
            'recharge_distributors',
            'recharge_reversals',
            'recharge_refunds',
            'recharge_commissions',
            'recharge_float_deposits',
            'recharge_daily_collections',
            'recharge_daily_reconciliation',
            'trusted_devices',
            'device_challenges'
          ]);
      }
    }

    // -------------------------------------------------------------
    // Global In-App Configuration
    // -------------------------------------------------------------
    match /app_config/{doc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------
    // Root Fallback Collections (Protected by isSignedIn)
    // -------------------------------------------------------------
    match /products/{id} { allow read, write: if isSignedIn(); }
    match /stock_units/{id} { allow read, write: if isSignedIn(); }
    match /purchase_bills/{id} {
      allow read, write: if isSignedIn();
      match /items/{itemId} { allow read, write: if isSignedIn(); }
    }
    match /vendor_ledger/{id} { allow read, write: if isSignedIn(); }
    match /accounting_cash_bank/{id} { allow read, write: if isSignedIn(); }
    match /parties/{id} { allow read, write: if isSignedIn(); }
    match /staff/{id} { allow read, write: if isSignedIn(); }
    match /staff_attendance/{id} { allow read, write: if isSignedIn(); }
    match /salary_payments/{id} { allow read, write: if isSignedIn(); }
    match /daily_registers/{id} { allow read, write: if isSignedIn(); }
    match /daily_sales/{id} { allow read, write: if isSignedIn(); }
    match /daily_sales_ledger/{id} { allow read, write: if isSignedIn(); }
    match /sales_orders/{id} { allow read, write: if isSignedIn(); }
    match /sales_invoices/{id} { allow read, write: if isSignedIn(); }
    match /sales/{id} { allow read, write: if isSignedIn(); }
    match /payment_records/{id} { allow read, write: if isSignedIn(); }
    match /payments/{id} { allow read, write: if isSignedIn(); }
    match /service_jobs/{id} { allow read, write: if isSignedIn(); }
    match /services/{id} { allow read, write: if isSignedIn(); }
    match /inventory/{id} { allow read, write: if isSignedIn(); }
    match /inventory_logs/{id} { allow read, write: if isSignedIn(); }
    match /counters/{id} { allow read, write: if isSignedIn(); }
    match /audit_logs/{id} { allow read, write: if isSignedIn(); }
  }
}
