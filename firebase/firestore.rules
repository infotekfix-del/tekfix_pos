rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }

    function shopDoc(shop) {
      return /databases/$(db)/documents/shops/$(shop);
    }

    function userDoc(shop) {
      return /databases/$(db)/documents/shops/$(shop)/users/$(request.auth.uid);
    }

    function staffDoc(shop) {
      return /databases/$(db)/documents/shops/$(shop)/staff/$(request.auth.uid);
    }

    function isShopOwner(shop) {
      return signedIn() && (
        (exists(shopDoc(shop)) && get(shopDoc(shop)).data.ownerUid == request.auth.uid) ||
        (exists(userDoc(shop)) && get(userDoc(shop)).data.get('role', '') == 'owner')
      );
    }

    function isShopMember(shop) {
      return signedIn() && (
        isShopOwner(shop) ||
        (exists(userDoc(shop)) &&
         get(userDoc(shop)).data.get('active', true) != false &&
         get(userDoc(shop)).data.get('approved', true) != false) ||
        exists(staffDoc(shop))
      );
    }

    function owner(shop) { return isShopOwner(shop); }
    function member(shop) { return isShopMember(shop); }

    function isStaffMatch(fieldVal) {
      return signedIn() && (
        fieldVal == request.auth.uid ||
        (request.auth.token.email != null && fieldVal == request.auth.token.email)
      );
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function ownRow() {
      return isStaffMatch(resource.data.staffId);
    }

    match /shops/{shop} {
      // First owner registers the shop (shop id must be unused)
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if member(shop);
      allow update, delete: if false;

      match /users/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || owner(shop));
        allow create: if signedIn() && (
          (uid == request.auth.uid && request.resource.data.role == 'owner' &&
            getAfter(shopDoc(shop)).data.ownerUid == request.auth.uid)
          || (owner(shop) && request.resource.data.role == 'staff'));
        allow update: if owner(shop) && uid != request.auth.uid && changesOnly(['active', 'name', 'approved']);
        allow delete: if false;
      }

      match /meta/{doc} {
        allow read: if member(shop);
        allow create: if owner(shop);
        allow update, delete: if false;
      }

      match /settings/{doc} {
        allow read: if member(shop);
        allow write: if owner(shop);
      }

      // ---- shared catalogue: staff may sell (stock / balance deltas only)
      match /items/{id} {
        allow read: if member(shop);
        allow create: if owner(shop);
        allow update: if owner(shop) || (member(shop) && changesOnly(['stock', '_u', '_by', '_st', 'updatedAt']));
        allow delete: if false;
      }

      match /inventory/{id} {
        allow read: if member(shop);
        allow create, delete: if owner(shop);
        allow update: if owner(shop) || (member(shop) && changesOnly(['stock', 'updatedAt']));
      }

      // Cost price is stored separately and is NEVER readable or writable by staff
      match /inventory_private/{itemId} {
        allow read, write: if owner(shop);
      }

      match /parties/{id} {
        allow read: if member(shop);
        allow create: if member(shop);
        allow update: if owner(shop) || (member(shop) && changesOnly(['balance', '_u', '_by', '_st']));
        allow delete: if false;
      }

      match /services/{id} {
        allow read: if member(shop);
        allow create, update: if member(shop);
        allow delete: if false;
      }

      // ---- sales: staff can only create if currently checked in (attendance doc exists & checkOut is null)
      match /sales/{id} {
        allow read: if owner(shop) || (member(shop) && ownRow());
        allow create: if signedIn() && (
          owner(shop) || (
            member(shop) &&
            isStaffMatch(request.resource.data.staffId) &&
            request.resource.data.attendanceDocId != null &&
            exists(/databases/$(db)/documents/shops/$(shop)/attendance/$(request.resource.data.attendanceDocId)) &&
            get(/databases/$(db)/documents/shops/$(shop)/attendance/$(request.resource.data.attendanceDocId)).data.get('checkOut', null) == null
          )
        );
        allow update: if owner(shop);
        allow delete: if false;
      }

      match /purchases/{id} { allow read, write: if owner(shop); }
      match /expenses/{id}  { allow read, write: if owner(shop); }
      match /staff/{id}     { allow read: if member(shop); allow write: if owner(shop); }

      // ---- attendance: staff can only create pending_approval and update check-out; approval & adjustments are owner-only
      match /attendance/{id} {
        allow read: if owner(shop) || (signedIn() && isStaffMatch(resource.data.staffId));
        allow create: if signedIn() && (
          owner(shop) || (
            member(shop) &&
            isStaffMatch(request.resource.data.staffId) &&
            request.resource.data.approvalStatus == 'pending_approval' &&
            request.resource.data.get('approvedBy', null) == null &&
            request.resource.data.get('approvedAt', null) == null &&
            request.resource.data.get('adjustedBy', null) == null &&
            request.resource.data.get('adjustReason', null) == null &&
            request.resource.data.get('originalCheckIn', null) == null &&
            request.resource.data.get('originalCheckOut', null) == null
          )
        );
        allow update: if signedIn() && (
          owner(shop) || (
            member(shop) &&
            isStaffMatch(resource.data.staffId) &&
            isStaffMatch(request.resource.data.staffId) &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'approvalStatus', 'approvedBy', 'approvedAt', 'adjustedBy', 'adjustReason', 'originalCheckIn', 'originalCheckOut', 'staffId'
            ])
          )
        );
        allow delete: if owner(shop);
      }

      // ---- append-only audit & approvals
      match /attendanceAudit/{id} {
        allow read: if owner(shop);
        allow create: if owner(shop);
        allow update, delete: if false;
      }

      match /priceApprovals/{id} {
        allow read: if owner(shop);
        allow create: if member(shop);
        allow update, delete: if false;
      }

      match /stockMovements/{id} {
        allow read: if owner(shop);
        allow create: if member(shop);
        allow update, delete: if false;
      }

      // ---- append-only streams written by every device, read by owner
      match /stock_moves/{id} {
        allow read: if owner(shop);
        allow create: if member(shop);
        allow update: if member(shop) && changesOnly(['_st', '_by', '_u']);
        allow delete: if false;
      }
      match /activity_logs/{id} {
        allow read: if owner(shop);
        allow create: if member(shop) && isStaffMatch(request.resource.data.staffId);
        allow update: if member(shop) && changesOnly(['_st']);   // log content is immutable
        allow delete: if false;
      }
      match /bank_txns/{id} {
        allow read: if owner(shop);
        allow create: if member(shop);
        allow update: if member(shop) && changesOnly(['_st', '_by']);
        allow delete: if false;
      }
      // cash / bank balances: staff may only add deltas, never read
      match /bank/{id} {
        allow read: if owner(shop);
        allow create: if member(shop) && request.resource.data.keys().hasOnly(['v', '_by', '_st']);
        allow update: if member(shop) && changesOnly(['v', '_by', '_st']);
        allow delete: if false;
      }

      // ---- staff orders: unified ecosystem orders with RBAC
      match /orders/{id} {
        allow read: if owner(shop) || (signedIn() && isStaffMatch(resource.data.staffId));
        allow create: if signedIn() && (
          owner(shop) || (
            member(shop) &&
            isStaffMatch(request.resource.data.staffId) &&
            request.resource.data.shopId == shop &&
            request.resource.data.status in ['submitted', 'pending'] &&
            request.resource.data.get('updatedBy', null) == null
          )
        );
        allow update: if owner(shop) || (
          member(shop) &&
          isStaffMatch(resource.data.staffId) &&
          changesOnly(['whatsappDeliveryStatus', 'whatsappMessageId', 'updatedAt'])
        );
        allow delete: if owner(shop);
      }

      // ---- sequential order counters
      match /counters/{id} {
        allow read, write: if signedIn() && (owner(shop) || member(shop));
      }
    }

    // ---- Global In-App Auto-Update Configuration
    match /app_config/{doc} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
