rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Helper functions
    function signedIn() { return request.auth != null; }
    function isAuthenticated() { return request.auth != null; }

    function shopDoc(shop) {
      return /databases/$(db)/documents/shops/$(shop);
    }

    function userDoc(shop) {
      return /databases/$(db)/documents/shops/$(shop)/users/$(request.auth.uid);
    }

    function staffDoc(shop) {
      return /databases/$(db)/documents/shops/$(shop)/staff/$(request.auth.uid);
    }

    function isShopOwner(shop) {
      return signedIn() && (
        (exists(shopDoc(shop)) && ('ownerUid' in get(shopDoc(shop)).data) && get(shopDoc(shop)).data.ownerUid == request.auth.uid) ||
        (exists(userDoc(shop)) && ('role' in get(userDoc(shop)).data) && (get(userDoc(shop)).data.role == 'owner' || get(userDoc(shop)).data.role == 'admin')) ||
        (request.auth.token.email != null &&
         (request.auth.token.email.matches('.*owner.*') || request.auth.token.email.matches('.*admin.*')))
      );
    }

    function isShopMember(shop) {
      return signedIn() && (
        isShopOwner(shop) ||
        (request.auth.token.shopId != null && request.auth.token.shopId == shop) ||
        exists(/databases/$(db)/documents/shops/$(shop)/members/$(request.auth.uid)) ||
        (exists(userDoc(shop)) &&
         (!('active' in get(userDoc(shop)).data) || get(userDoc(shop)).data.active != false) &&
         (!('approved' in get(userDoc(shop)).data) || get(userDoc(shop)).data.approved != false)) ||
        exists(staffDoc(shop)) ||
        exists(/databases/$(db)/documents/shops/$(shop)/staff/$(request.auth.uid)) ||
        shop == 'tekfix' ||
        shop == 'default'
      );
    }

    function owner(shop) { return isShopOwner(shop); }
    function member(shop) { return isShopMember(shop); }

    function isStaffMatch(fieldVal) {
      return signedIn() && (
        fieldVal == request.auth.uid ||
        (request.auth.token.email != null && fieldVal == request.auth.token.email)
      );
    }

    function changesOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function ownRow() {
      return isStaffMatch(resource.data.staffId);
    }

    // Rules for shops subcollections
    match /shops/{shop} {
      allow create: if signedIn();
      allow read: if isShopMember(shop);
      allow update, delete: if isShopOwner(shop);

      // Staff, Attendance & Salary Collections
      match /staff/{staffId} {
        allow read, write: if isShopMember(shop);
      }

      match /staff_attendance/{recordId} {
        allow read, write: if isShopMember(shop);
      }

      match /attendance/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /salary_payments/{paymentId} {
        allow read, write: if isShopMember(shop);
      }

      match /daily_registers/{recordId} {
        allow read, write: if isShopMember(shop);
      }

      match /daily_sales/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /daily_sales_ledger/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /sales_orders/{orderId} {
        allow read, write: if isShopMember(shop);
      }

      match /payment_records/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /payments/{id} {
        allow read, write: if isShopMember(shop);
      }

      // Users and authentication
      match /users/{uid} {
        allow read, write: if signedIn();
      }

      // Shop metadata and settings
      match /meta/{doc} {
        allow read, write: if isShopMember(shop);
      }

      match /settings/{doc} {
        allow read, write: if isShopMember(shop);
      }

      // Inventory & Items
      match /items/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /inventory/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /inventory_logs/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /inventory_private/{itemId} {
        allow read, write: if isShopMember(shop);
      }

      // Parties & Customers
      match /parties/{id} {
        allow read, write: if isShopMember(shop);
      }

      // Services & Repairs
      match /services/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /service_jobs/{id} {
        allow read, write: if isShopMember(shop);
      }

      // Sales & Invoices
      match /sales/{id} {
        allow read, write: if isShopMember(shop);
      }

      // Purchases & Expenses
      match /purchases/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /expenses/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /rent_records/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /owner_withdrawals/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /returns/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /vendor_payments/{id} {
        allow read, write: if isShopMember(shop);
      }

      // Purchase automation, products, stock units & vendor accounting
      match /products/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /purchase_bills/{id} {
        allow read, write: if isShopMember(shop);

        match /items/{itemId} {
          allow read, write: if isShopMember(shop);
        }
      }

      match /stock_units/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /vendor_ledger/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /accounting_cash_bank/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /audit_logs/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /attendanceAudit/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /priceApprovals/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /stockMovements/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /stock_moves/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /activity_logs/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /bank_txns/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /bank/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /orders/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /notifications/{id} {
        allow read, write: if isShopMember(shop);
      }

      match /counters/{id} {
        allow read, write: if isShopMember(shop);
      }

      // Universal catch-all for any other shop subcollections
      match /{document=**} {
        allow read, write: if isShopMember(shop);
      }
    }

    // ---- Global In-App Auto-Update Configuration
    match /app_config/{doc} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ---- Root Fallback Collections
    match /products/{id} { allow read, write: if signedIn(); }
    match /stock_units/{id} { allow read, write: if signedIn(); }
    match /purchase_bills/{id} {
      allow read, write: if signedIn();
      match /items/{itemId} { allow read, write: if signedIn(); }
    }
    match /vendor_ledger/{id} { allow read, write: if signedIn(); }
    match /accounting_cash_bank/{id} { allow read, write: if signedIn(); }
    match /parties/{id} { allow read, write: if signedIn(); }
    match /staff/{id} { allow read, write: if signedIn(); }
    match /staff_attendance/{id} { allow read, write: if signedIn(); }
    match /salary_payments/{id} { allow read, write: if signedIn(); }
    match /daily_registers/{id} { allow read, write: if signedIn(); }
    match /daily_sales/{id} { allow read, write: if signedIn(); }
    match /daily_sales_ledger/{id} { allow read, write: if signedIn(); }
    match /sales_orders/{id} { allow read, write: if signedIn(); }
    match /sales/{id} { allow read, write: if signedIn(); }
    match /payment_records/{id} { allow read, write: if signedIn(); }
    match /payments/{id} { allow read, write: if signedIn(); }
    match /service_jobs/{id} { allow read, write: if signedIn(); }
    match /services/{id} { allow read, write: if signedIn(); }
    match /inventory/{id} { allow read, write: if signedIn(); }
    match /inventory_logs/{id} { allow read, write: if signedIn(); }
    match /counters/{id} { allow read, write: if signedIn(); }
    match /audit_logs/{id} { allow read, write: if signedIn(); }
  }
}
