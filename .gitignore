# ==============================================================================
# Comprehensive .gitignore for TekFix Unified Ecosystem (Flutter + Android / Kotlin)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Build Outputs, Binaries, and Compilations
# ------------------------------------------------------------------------------
/build/
**/build/
.dart_tool/
.pub-cache/
.pub/
.flutter-plugins-dependencies
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
/android/app/debug/
/android/app/profile/
/android/app/release/

# Gradle Build Cache and Temporary Outputs
.gradle/
**/.gradle/
**/build-cache/
**/reports/
**/test-results/
*.class
*.dex

# Packaging & Release Artifacts
*.apk
*.ap_
*.aab
*.ipa
*.exe
*.dll
*.lib
*.obj
*.exp
*.pdb
*.zip
*.tar.gz
*.7z
*.rar

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ------------------------------------------------------------------------------
# 2. IDE, Editor & Workspace Files
# ------------------------------------------------------------------------------
.idea/
**/.idea/
.vscode/
**/.vscode/
*.iml
**/*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.history/
.atom/
.buildlog/
.widget_preview/

# ------------------------------------------------------------------------------
# 3. Sensitive Credentials, Keystores, Secrets & Environment
# ------------------------------------------------------------------------------
# Android Keystores & Signing Keys
*.keystore
*.jks
*.key
*.p12
*.pem
*.cer
key.properties
**/key.properties

# Firebase Client Secrets & Local Configs
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist

# Local SDK and Environment Paths
local.properties
**/local.properties
.env*
!*.env.example

# ------------------------------------------------------------------------------
# 4. OS & Miscellaneous
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.log
*.swp
*~
